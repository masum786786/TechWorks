# ==========================================
# TechWorks - Free Tier Environment Template
# ==========================================
# Copy this file to '.env' for local development or set these variables
# in your deployment platform (Vercel, Netlify, Render, Railway, etc.)

# 1. Supabase (100% Free Tier):
# Create a free project at https://supabase.com
# Go to Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Port (Optional, defaults to 3000):
PORT=3000
